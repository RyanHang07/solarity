NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SUPABASE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VAPID_PRIVATE_KEY=
TURNSTILE_SECRET_KEY=

# Brevo SMTP. Supabase Auth reads its own copy from the dashboard; these are
# for anything the app sends directly, such as the support contact form, and
# for scripts/test-email.mjs.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER=
BREVO_ALERT_TO=

# End-to-end tests (Playwright). Both must be real accounts that already exist
# in auth.users and have completed onboarding.
E2E_OWNER_EMAIL=
E2E_JOINER_EMAIL=
# A third real account that is ALREADY a site admin. `users.role` is in no
# client grant, so the suite cannot promote one — set it once with SQL:
#   update public.users u set role = 'admin'
#     from auth.users au where au.id = u.id and au.email = '...';
E2E_ADMIN_EMAIL=
# Optional. Defaults to http://localhost:3000
E2E_BASE_URL=

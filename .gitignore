# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local cli state
supabase/.temp/
supabase/.branches/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
e2e/.auth/

# graphify
.graphifyignore
# A machine-local absolute path. Meaningless in anyone else's clone.
graphify-out/.graphify_root
# Content-hashed AST cache. It makes the *next* run fast on one machine; in the
# repository it is 89 files that get renamed wholesale on every regeneration.
# `graph.json` and `manifest.json` are the artefacts worth tracking.
graphify-out/cache/
graphify-out/.graphify_analysis.json

# cursor
.cursor/
